{
  "uid": "ep3-observabilidad",
  "title": "EP3 Observabilidad recomendaciones-svc",
  "tags": [
    "ep3",
    "recomendaciones-svc"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {"id": 1, "type": "stat", "title": "Pods del servicio arriba", "description": "Cuántas réplicas de recomendaciones-svc responden a Prometheus. Si baja de 2 se pierde la alta disponibilidad.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(up{job=\"recomendaciones-svc\"})", "instant": true}], "fieldConfig": {"defaults": {"unit": "none", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 1}, {"color": "green", "value": 2}]}, "color": {"mode": "thresholds"}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "value"}},
    {"id": 2, "type": "stat", "title": "Cobertura de pruebas (líneas)", "description": "Última cobertura JaCoCo empujada por el pipeline. El gate exige 100 %, si baja se revisa antes de seguir.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "ci_cobertura_lineas_percent{job=\"pipeline-eks\"}", "instant": true}], "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 90}, {"color": "green", "value": 100}]}, "color": {"mode": "thresholds"}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "value"}},
    {"id": 3, "type": "stat", "title": "Tiempo del último despliegue", "description": "Duración del último despliegue a EKS medida por el pipeline. Si crece mucho, hay que revisar qué se ralentizó.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "ci_despliegue_duracion_segundos{job=\"pipeline-eks\"}", "instant": true}], "fieldConfig": {"defaults": {"unit": "s", "decimals": 0, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 300}, {"color": "red", "value": 600}]}, "color": {"mode": "thresholds"}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "value"}},
    {"id": 4, "type": "stat", "title": "Errores 5xx por segundo", "description": "Errores del servidor en los últimos 5 minutos. Si sube, se investiga o se hace rollback.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(http_server_requests_seconds_count{application=\"recomendaciones-svc\", status=~\"5..\"}[5m])) or vector(0)", "instant": true}], "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 3, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 0.05}]}, "color": {"mode": "thresholds"}}, "overrides": []}, "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "colorMode": "background", "graphMode": "none", "textMode": "value"}},
    {"id": 5, "type": "timeseries", "title": "Uso de CPU por contenedor", "description": "CPU real de cada contenedor leída de cAdvisor. Sirve para decidir límites del pod y el umbral del HPA.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (pod, container) (rate(container_cpu_usage_seconds_total{namespace=\"recomendaciones-eks\", container=~\"app|postgres\"}[2m]))", "legendFormat": "{{pod}} / {{container}}"}], "fieldConfig": {"defaults": {"unit": "none", "custom": {"lineWidth": 2, "fillOpacity": 10, "showPoints": "auto"}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 6, "type": "timeseries", "title": "Uso de memoria por contenedor", "description": "Memoria en uso de cada contenedor (cgroup). Si se acerca al límite, el pod corre riesgo de reiniciarse.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (pod, container) (container_memory_working_set_bytes{namespace=\"recomendaciones-eks\", container=~\"app|postgres\"})", "legendFormat": "{{pod}} / {{container}}"}], "fieldConfig": {"defaults": {"unit": "bytes", "custom": {"lineWidth": 2, "fillOpacity": 10, "showPoints": "auto"}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 7, "type": "timeseries", "title": "Errores 5xx por segundo", "description": "Errores registrados por el servicio a lo largo del tiempo.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum(rate(http_server_requests_seconds_count{application=\"recomendaciones-svc\", status=~\"5..\"}[5m])) or vector(0)", "legendFormat": "errores 5xx"}], "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 2, "fillOpacity": 10, "showPoints": "auto"}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 8, "type": "timeseries", "title": "Peticiones por segundo según estado", "description": "Tráfico del servicio separado por código de respuesta.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"recomendaciones-svc\"}[5m]))", "legendFormat": "estado {{status}}"}], "fieldConfig": {"defaults": {"unit": "reqps", "custom": {"lineWidth": 2, "fillOpacity": 10, "showPoints": "auto"}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 9, "type": "timeseries", "title": "Cobertura de pruebas en cada despliegue", "description": "Historial de la cobertura que reporta el pipeline.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "ci_cobertura_lineas_percent{job=\"pipeline-eks\"}", "legendFormat": "cobertura de líneas"}], "fieldConfig": {"defaults": {"unit": "percent", "custom": {"lineWidth": 2, "fillOpacity": 10, "showPoints": "auto"}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}},
    {"id": 10, "type": "timeseries", "title": "Duración de cada despliegue", "description": "Historial del tiempo que tarda el pipeline en desplegar a EKS.", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20}, "targets": [{"refId": "A", "datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "ci_despliegue_duracion_segundos{job=\"pipeline-eks\"}", "legendFormat": "segundos"}], "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineWidth": 2, "fillOpacity": 10, "showPoints": "auto"}}, "overrides": []}, "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}}
  ]
}